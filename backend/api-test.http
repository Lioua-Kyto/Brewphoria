### BrewPhoria API Test File
### Base URL
@baseUrl = http://localhost:3000/api/v1
@authToken = Bearer YOUR_FIREBASE_ID_TOKEN_HERE

### ── Health ─────────────────────────────────────────────────────────────────

GET http://localhost:3000/health

### ── Auth ───────────────────────────────────────────────────────────────────

# Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "idToken": "your-firebase-id-token"
}

###

# Update FCM Token
PATCH {{baseUrl}}/auth/fcm-token
Content-Type: application/json
Authorization: {{authToken}}

{
  "fcmToken": "your-fcm-device-token"
}

### ── Categories ──────────────────────────────────────────────────────────────

GET {{baseUrl}}/categories

### ── Products ───────────────────────────────────────────────────────────────

# List products
GET {{baseUrl}}/products

###

# List with filters
GET {{baseUrl}}/products?search=espresso&limit=10&page=1

###

# Get product by slug
GET {{baseUrl}}/products/ethiopia-yirgacheffe

###

# Get product reviews
GET {{baseUrl}}/products/clxxxxxxxxxxxxxxxxxxxxxxxx/reviews

### ── Cart ────────────────────────────────────────────────────────────────────

# Get cart
GET {{baseUrl}}/cart
Authorization: {{authToken}}

###

# Add item
POST {{baseUrl}}/cart/items
Content-Type: application/json
Authorization: {{authToken}}

{
  "productId": "clxxxxxxxxxxxxxxxxxxxxxxxx",
  "quantity": 2
}

###

# Update item quantity
PATCH {{baseUrl}}/cart/items/clxxxxxxxxxxxxxxxxxxxxxxxx
Content-Type: application/json
Authorization: {{authToken}}

{
  "quantity": 3
}

###

# Clear cart
DELETE {{baseUrl}}/cart
Authorization: {{authToken}}

### ── Orders ──────────────────────────────────────────────────────────────────

# Checkout
POST {{baseUrl}}/orders/checkout
Content-Type: application/json
Authorization: {{authToken}}

{
  "addressId": "clxxxxxxxxxxxxxxxxxxxxxxxx",
  "pointsToRedeem": 0,
  "notes": "Please leave at door"
}

###

# Get orders
GET {{baseUrl}}/orders
Authorization: {{authToken}}

### ── Loyalty ──────────────────────────────────────────────────────────────────

GET {{baseUrl}}/loyalty
Authorization: {{authToken}}

###

POST {{baseUrl}}/loyalty/redeem
Content-Type: application/json
Authorization: {{authToken}}

{
  "pointsToRedeem": 500
}

### ── Chat ────────────────────────────────────────────────────────────────────

POST {{baseUrl}}/chat/message
Content-Type: application/json
Authorization: {{authToken}}

{
  "message": "What are your best single-origin coffees?"
}

### ── Admin ───────────────────────────────────────────────────────────────────

GET {{baseUrl}}/admin/dashboard
Authorization: {{authToken}}

###

GET {{baseUrl}}/admin/orders?status=PENDING&page=1&limit=20
Authorization: {{authToken}}

###

PATCH {{baseUrl}}/admin/orders/clxxxxxxxxxxxxxxxxxxxxxxxx/status
Content-Type: application/json
Authorization: {{authToken}}

{
  "status": "CONFIRMED"
}