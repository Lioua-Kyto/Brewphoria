// This is your Prisma schema file for BrewPhoria

generator client {
  provider   = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── ENUMS ─────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  EXPIRED
  BONUS
}

enum NotificationType {
  ORDER_STATUS_CHANGED
  NEW_SALE
  NEW_ORDER
  NEW_REVIEW
  LOYALTY_TIER_UP
  POINTS_EXPIRING
}

enum ModifierSelectionType {
  SINGLE
  MULTI
}

// Drives which option groups & detail metadata a product's detail screen
// shows — see ProductService.getBySlug. DRINK gets full customization (size/
// milk/sweetness/add-ons) + all detail stats; BEANS gets grind selection +
// roast/tasting-note metadata only; MERCH gets neither.
enum ProductType {
  DRINK
  BEANS
  MERCH
}

// ── MODELS ────────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  firebaseUid    String   @unique
  email          String   @unique
  displayName    String
  firstName      String?
  lastName       String?
  avatarUrl      String?
  role           Role     @default(USER)
  fcmToken       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cart           Cart?
  orders         Order[]
  reviews        Review[]
  loyaltyAccount LoyaltyAccount?
  notifications  Notification[]
  addresses      Address[]
  wishlist       WishlistItem[]

  @@index([firebaseUid])
  @@index([email])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  fullName   String
  phone      String
  street     String
  city       String
  state      String
  postalCode String
  country    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  orders Order[]

  @@index([userId])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  imageUrl  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products       Product[]
  modifierGroups ModifierGroup[]

  @@index([slug])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  price       Decimal  @db.Decimal(10, 2)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  images      String[]
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  avgRating   Decimal  @default(0) @db.Decimal(3, 2)
  reviewCount Int      @default(0)
  // Drives which customization option groups and detail metadata apply —
  // see the ProductType enum doc comment.
  type        ProductType @default(MERCH)
  // Optional detail metadata
  roastLevel   String?
  calories     Int?
  caffeineMg   Int?
  prepMinutes  Int?
  tastingNotes String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems    CartItem[]
  orderItems   OrderItem[]
  reviews      Review[]
  wishlistedBy WishlistItem[]

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([slug])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime   @updatedAt

  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  // Selected modifier snapshot: [{ groupId, groupName, optionId, label, priceDelta }]
  modifiers Json     @default("[]")
  // Base price + sum(modifier deltas), computed server-side at add time.
  unitPrice Decimal  @db.Decimal(10, 2)
  addedAt   DateTime @default(now())

  @@index([cartId])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  addressId       String
  address         Address     @relation(fields: [addressId], references: [id])
  items           OrderItem[]
  subtotal        Decimal     @db.Decimal(10, 2)
  deliveryFee     Decimal     @db.Decimal(10, 2)
  discount        Decimal     @default(0) @db.Decimal(10, 2)
  loyaltyDiscount Decimal     @default(0) @db.Decimal(10, 2)
  tip             Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  pointsEarned    Int         @default(0)
  pointsRedeemed  Int         @default(0)
  status          OrderStatus @default(PENDING)
  paymentMethod   String      @default("COD")
  notes           String?
  estimatedReadyAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  loyaltyTx LoyaltyTransaction[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  productName  String
  productImage String
  unitPrice    Decimal @db.Decimal(10, 2)
  quantity     Int
  subtotal     Decimal @db.Decimal(10, 2)
  modifiers    Json    @default("[]")

  review Review?

  @@index([orderId])
  @@index([productId])
}

model Review {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  rating      Int
  comment     String
  images      String[]
  isVisible   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, orderItemId])
  @@index([productId, isVisible])
  @@index([userId])
}

model LoyaltyAccount {
  id             String      @id @default(cuid())
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentPoints  Int         @default(0)
  lifetimePoints Int         @default(0)
  tier           LoyaltyTier @default(BRONZE)
  updatedAt      DateTime    @updatedAt

  transactions LoyaltyTransaction[]

  @@index([userId])
}

model LoyaltyTransaction {
  id          String                 @id @default(cuid())
  accountId   String
  account     LoyaltyAccount         @relation(fields: [accountId], references: [id])
  orderId     String?
  order       Order?                 @relation(fields: [orderId], references: [id])
  type        LoyaltyTransactionType
  points      Int
  description String
  expiresAt   DateTime?
  createdAt   DateTime               @default(now())

  @@index([accountId, createdAt(sort: Desc)])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt(sort: Desc)])
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  messages ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

// ── Product customization (modifiers) ─────────────────────────────────────────

model ModifierGroup {
  id            String                @id @default(cuid())
  categoryId    String
  category      Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name          String
  selectionType ModifierSelectionType @default(SINGLE)
  isRequired    Boolean               @default(false)
  sortOrder     Int                   @default(0)
  createdAt     DateTime              @default(now())

  options ModifierOption[]

  @@index([categoryId])
}

model ModifierOption {
  id         String        @id @default(cuid())
  groupId    String
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label      String
  priceDelta Decimal       @default(0) @db.Decimal(10, 2)
  isDefault  Boolean       @default(false)
  sortOrder  Int           @default(0)

  @@index([groupId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt(sort: Desc)])
}
